<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>KuumoApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Product>Kuumo App</Product>
    <Company>kuumoneko</Company>
    <Description>Kuumo App music player</Description>
    <Version>6.0.0</Version>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(EnableMsix)' == 'true'">MSIX</WindowsPackageType>
    <WindowsPackageType Condition="'$(EnableMsix)' != 'true'">None</WindowsPackageType>
    <!-- Framework-dependent Windows App SDK: runtime installed machine-wide (setup.iss ships it).
         Bootstrap is initialized manually in Program.cs (WindowsAppSdkBootstrapInitialize=false). -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <!-- We provide our own Main in Program.cs (required for DLL redirection to include\). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AppxPackageSigningEnabled Condition="'$(EnableMsix)' == 'true'">true</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile Condition="'$(EnableMsix)' == 'true'">KuumoApp_TemporaryKey.pfx</PackageCertificateKeyFile>
    <PackageCertificateThumbprint Condition="'$(EnableMsix)' == 'true'">1838FFAB69D562AB4BC94C105AFC9369CDB96D45</PackageCertificateThumbprint>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\SplashScreen.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square150x150Logo.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square310x310Logo.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square71x71Logo.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\StoreLogo.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.png" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
</Project>
