<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:KuumoApp.Controls">

    <DataTemplate x:Key="CardTemplate">
        <Grid
            Width="120"
            Margin="0,0,10,10"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="120" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image
                helpers:ImageAttach.SourceUrl="{Binding Thumbnail}"
                helpers:ImageAttach.SquareCrop="True"
                Width="120"
                Height="120"
                Stretch="UniformToFill" />
            <StackPanel
                Grid.Row="1"
                Padding="8,6"
                Spacing="2">
                <TextBlock
                    Text="{Binding Title}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Text="{Binding Subtitle}"
                    FontSize="11"
                    Opacity="0.7"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TrackRowTemplate">
        <Grid
            Padding="12,8"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Width="64"
                Height="64"
                CornerRadius="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Image
                    helpers:ImageAttach.SourceUrl="{Binding Thumbnail}"
                    Width="64"
                    Height="64"
                    Stretch="UniformToFill" />
            </Border>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    Text="{Binding Title}"
                    FontSize="15"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Text="{Binding Artist}"
                    FontSize="13"
                    Opacity="0.7"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                Text="{Binding DurationText}"
                FontSize="13"
                Opacity="0.7"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="3"
                Tag="{Binding}"
                Padding="8"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="More options">
                <FontIcon
                    Glyph="&#xE712;"
                    FontSize="14"
                    Opacity="0.7" />
            </Button>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
