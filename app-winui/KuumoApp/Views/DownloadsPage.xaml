<Page
    x:Class="KuumoApp.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:KuumoApp.Controls"
    xmlns:local="using:KuumoApp.Views">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="Download queue"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Style="{StaticResource AppAccentTitleStyle}" />
                <Button
                    x:Name="DownloadButton"
                    Grid.Column="1"
                    Content="Download"
                    Style="{StaticResource AppAccentButtonStyle}"
                    Click="OnDownloadClick" />
                <Button
                    x:Name="ClearButton"
                    Grid.Column="2"
                    Content="Clear queue"
                    Click="OnClearClick" />
            </Grid>
            <TextBlock
                x:Name="StatusText"
                Text="Idle"
                FontSize="14"
                Opacity="0.8" />
            <ProgressBar
                x:Name="Progress"
                IsIndeterminate="True"
                Visibility="Collapsed" />
        </StackPanel>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Text="Download queue is empty"
            Opacity="0.7"
            FontSize="14"
            Visibility="Collapsed" />

        <ListView
            Grid.Row="1"
            x:Name="QueueList"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DownloadQueueItem">
                    <Grid
                        Padding="12,8"
                        ColumnSpacing="12"
                        RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button
                            Tag="{Binding}"
                            Padding="6"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnRemoveClick"
                            ToolTipService.ToolTip="Remove from queue">
                            <FontIcon
                                Glyph="&#xE711;"
                                FontSize="12"
                                Opacity="0.7" />
                        </Button>
                        <Border
                            Grid.Column="1"
                            Width="64"
                            Height="64"
                            CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Image
                                helpers:ImageAttach.SourceUrl="{Binding Thumbnail}"
                                Width="64"
                                Height="64"
                                Stretch="UniformToFill" />
                        </Border>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                Text="{Binding Name}"
                                FontSize="15"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="{Binding ModeLabel}"
                                    FontSize="12"
                                    Opacity="0.7" />
                                <TextBlock
                                    Text="{Binding Subtitle}"
                                    FontSize="12"
                                    Opacity="0.7"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <Button
                            Grid.Column="3"
                            Tag="{Binding}"
                            Padding="6"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCopyClick"
                            ToolTipService.ToolTip="Copy link">
                            <FontIcon
                                Glyph="&#xE8C8;"
                                FontSize="14"
                                Opacity="0.7" />
                        </Button>

                        <ItemsControl
                            Grid.Row="1"
                            Grid.ColumnSpan="4"
                            ItemsSource="{Binding Tracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TrackRow">
                                    <Grid
                                        Padding="12,6"
                                        ColumnSpacing="12"
                                        Margin="64,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="48"
                                            Height="48"
                                            CornerRadius="4"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Image
                                                helpers:ImageAttach.SourceUrl="{Binding Thumbnail}"
                                                Width="48"
                                                Height="48"
                                                Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                Text="{Binding Title}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding Artist}"
                                                FontSize="12"
                                                Opacity="0.7"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding DurationText}"
                                            FontSize="12"
                                            Opacity="0.7"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
