<Page
    x:Class="KuumoApp.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:KuumoApp.Controls">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="160"
                Height="160"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Image
                    x:Name="HeaderThumb"
                    Width="160"
                    Height="160"
                    Stretch="UniformToFill" />
            </Border>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="8">
                <TextBlock
                    x:Name="HeaderKind"
                    FontSize="12"
                    Opacity="0.7" />
                <TextBlock
                    x:Name="HeaderTitle"
                    FontSize="28"
                    FontWeight="Bold"
                    Style="{StaticResource AppAccentTitleStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="HeaderSubtitle"
                    FontSize="13"
                    Opacity="0.7" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="ShareButton"
                        Content="Copy link"
                        Click="OnShareClick"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="DownloadButton"
                        Content="Download"
                        Click="OnDownloadClick"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="RefreshButton"
                        Content="Refresh"
                        Click="OnRefreshClick"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="PinButton"
                        Click="OnPinClick"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="DeleteButton"
                        Content="Delete"
                        Click="OnDeleteClick"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="PlayAllButton"
                        Content="Play"
                        Style="{StaticResource AppAccentButtonStyle}"
                        Click="OnPlayAllClick"
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock
            Grid.Row="1"
            x:Name="ErrorText"
            Text=""
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Visibility="Collapsed" />

        <ListView
            Grid.Row="2"
            x:Name="TrackList"
            ItemTemplate="{StaticResource TrackRowTemplate}"
            IsItemClickEnabled="True"
            ItemClick="OnTrackClick"
            RightTapped="OnTrackRightTapped"
            SelectionMode="None" />
    </Grid>
</Page>
