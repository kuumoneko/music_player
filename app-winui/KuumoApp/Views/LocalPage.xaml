<Page
    x:Class="KuumoApp.Views.LocalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="LocalTitle"
                Text="Local files"
                FontSize="24"
                FontWeight="SemiBold"
                Style="{StaticResource AppAccentTitleStyle}"
                VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBox
                    x:Name="FilterBox"
                    PlaceholderText="Filter"
                    Width="180"
                    TextChanged="OnFilterChanged"
                    AutomationProperties.Name="Filter local files" />
                <Button Content="Refresh" Click="OnRefreshClick" AutomationProperties.Name="Refresh" />
                <Button Content="Reload" Click="OnReloadClick" AutomationProperties.Name="Reload" />
            </StackPanel>
        </Grid>

        <ListView
            Grid.Row="1"
            x:Name="LocalList"
            ItemTemplate="{StaticResource TrackRowTemplate}"
            IsItemClickEnabled="True"
            ItemClick="OnLocalClick"
            RightTapped="OnLocalRightTapped"
            SelectionMode="Single"
            AutomationProperties.Name="Local files" />

        <TextBlock
            Grid.Row="1"
            x:Name="EmptyText"
            Text="No local files found. Set a music folder in Settings."
            Opacity="0.7"
            FontSize="14"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />

        <ProgressRing
            Grid.Row="1"
            x:Name="LoadingRing"
            IsActive="False"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>
