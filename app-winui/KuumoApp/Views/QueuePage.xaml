<Page
    x:Class="KuumoApp.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="QueueTitle"
                    Text="Play queue"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Style="{StaticResource AppAccentTitleStyle}" />
                <Button
                    Grid.Column="1"
                    Content="Clear queue"
                    Click="OnClearQueueClick" />
                <Button
                    Grid.Column="2"
                    Content="Clear next from"
                    Click="OnClearNextfromClick" />
            </Grid>
            <TextBlock
                x:Name="FromText"
                Text=""
                FontSize="14"
                Opacity="0.7"
                Visibility="Collapsed" />
        </StackPanel>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Text="Queue is empty"
            Opacity="0.7"
            FontSize="14"
            Visibility="Collapsed" />

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="QueueSectionTitle"
                    Text="Play Queue"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Opacity="0.8"
                    Visibility="Collapsed" />
                <ListView
                    x:Name="QueueList"
                    MaxHeight="400"
                    ItemTemplate="{StaticResource TrackRowTemplate}"
                    IsItemClickEnabled="True"
                    ItemClick="OnQueueItemClick"
                    RightTapped="OnQueueRightTapped"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <TextBlock
                    x:Name="UpcomingTitle"
                    Text="Upcoming"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Opacity="0.8"
                    Margin="0,16,0,0"
                    Visibility="Collapsed" />
                <ListView
                    x:Name="UpcomingList"
                    MaxHeight="400"
                    ItemTemplate="{StaticResource TrackRowTemplate}"
                    IsItemClickEnabled="True"
                    ItemClick="OnUpcomingItemClick"
                    RightTapped="OnUpcomingRightTapped"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
