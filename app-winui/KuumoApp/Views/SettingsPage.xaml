<Page
    x:Class="KuumoApp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KuumoApp.Controls"
    NavigationCacheMode="Enabled">

    <ScrollViewer>
        <StackPanel
            Padding="24"
            Spacing="24">

            <StackPanel Spacing="8">
                <TextBlock Text="General" FontSize="20" FontWeight="SemiBold" Style="{StaticResource AppAccentTitleStyle}" />
                <ToggleSwitch x:Name="QuitOnCloseSwitch" Header="Quit app on window close" Toggled="OnQuitOnCloseToggled" />
                <ToggleSwitch x:Name="CloseToTraySwitch" Header="Close to tray" Toggled="OnCloseToTrayToggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Theme" FontSize="20" FontWeight="SemiBold" Style="{StaticResource AppAccentTitleStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton x:Name="DarkThemeRadio" Content="Dark" GroupName="ThemeGroup" Checked="OnThemeModeChanged" />
                    <RadioButton x:Name="LightThemeRadio" Content="Light" GroupName="ThemeGroup" Checked="OnThemeModeChanged" />
                    <RadioButton x:Name="SystemThemeRadio" Content="System" GroupName="ThemeGroup" Checked="OnThemeModeChanged" />
                </StackPanel>
                <ToggleSwitch x:Name="DynamicAccentSwitch" Header="Accent from artwork" Toggled="OnDynamicAccentToggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Equalizer" FontSize="20" FontWeight="SemiBold" Style="{StaticResource AppAccentTitleStyle}" />
                <ToggleSwitch x:Name="EqualizerSwitch" Header="Enable equalizer" Toggled="OnEqualizerToggled" />
                <ComboBox
                    x:Name="PresetBox"
                    Header="Preset"
                    SelectionChanged="OnPresetChanged"
                    PlaceholderText="Flat" />
                <controls:EqGraphControl x:Name="EqGraph" Height="200" BandsChanged="OnEqBandsChanged" />
                <TextBlock FontSize="12" Opacity="0.7" Text="Drag a handle up/down to boost or cut that band (-12 to +12 dB). Double-tap a handle to reset it." TextWrapping="Wrap" />
                <Button Content="Reset all" Click="OnEqResetClick" AutomationProperties.Name="Reset all" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Local music folder" FontSize="20" FontWeight="SemiBold" Style="{StaticResource AppAccentTitleStyle}" />
                <TextBlock x:Name="FolderText" FontSize="12" Opacity="0.7" Text="Not set" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Choose folder..." Click="OnChooseFolderClick" AutomationProperties.Name="Choose folder" />
                    <Button Content="Rehash" Click="OnRehashClick" AutomationProperties.Name="Rehash" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Discord RPC" FontSize="20" FontWeight="SemiBold" Style="{StaticResource AppAccentTitleStyle}" />
                <TextBlock x:Name="DiscordText" FontSize="12" Opacity="0.7" Text="Not connected" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Connect" Click="OnDiscordConnectClick" AutomationProperties.Name="Connect to Discord" />
                    <Button Content="Disconnect" Click="OnDiscordDisconnectClick" AutomationProperties.Name="Disconnect from Discord" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="GoogleSection" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Google account" FontSize="20" FontWeight="SemiBold" Style="{StaticResource AppAccentTitleStyle}" />
                <TextBlock x:Name="GoogleText" FontSize="12" Opacity="0.7" Text="Not signed in" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SignInButton" Content="Sign in" Click="OnSignInClick" AutomationProperties.Name="Sign in to Google" />
                    <Button x:Name="SignOutButton" Content="Sign out" Click="OnSignOutClick" AutomationProperties.Name="Sign out of Google" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="YouTube API Keys" FontSize="20" FontWeight="SemiBold" Style="{StaticResource AppAccentTitleStyle}" />
                <TextBlock FontSize="12" Opacity="0.7" Text="Optional. Improves metadata quality when added." TextWrapping="Wrap" />
                <TextBlock x:Name="ApiKeysStatusText" FontSize="12" Opacity="0.7" Text="No API keys configured" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="ApiKeyTextBox" PlaceholderText="Enter YouTube Data API key" AutomationProperties.Name="YouTube Data API key" Width="300" />
                    <Button Content="Add" Click="OnAddApiKeyClick" AutomationProperties.Name="Add API key" />
                </StackPanel>
                <Button x:Name="RemoveApiKeyButton" Content="Remove API Key" Click="OnRemoveApiKeyClick" AutomationProperties.Name="Remove API key" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="YouTube cookies" FontSize="20" FontWeight="SemiBold" Style="{StaticResource AppAccentTitleStyle}" />
                <TextBlock FontSize="12" Opacity="0.7" Text="Optional. Paste the Cookie header from a signed-in youtube.com session to reduce rate-limit errors. Stored locally and never uploaded." TextWrapping="Wrap" />
                <TextBox
                    x:Name="CookiesBox"
                    PlaceholderText="VISITOR_INFO1_LIVE=...; YSC=..."
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="84"
                    IsSpellCheckEnabled="False"
                    AutomationProperties.Name="YouTube cookies" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save cookies" Click="OnSaveCookiesClick" AutomationProperties.Name="Save YouTube cookies" />
                    <Button Content="Clear cookies" Click="OnClearCookiesClick" AutomationProperties.Name="Clear YouTube cookies" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Data and logs" FontSize="20" FontWeight="SemiBold" Style="{StaticResource AppAccentTitleStyle}" />
                <TextBlock FontSize="12" Opacity="0.7" Text="Settings, queue and logs live in the app data folder as app_data.sqlite." TextWrapping="Wrap" />
                <Button Content="Open data folder" Click="OnOpenDataFolderClick" AutomationProperties.Name="Open app data folder" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="About" FontSize="20" FontWeight="SemiBold" Style="{StaticResource AppAccentTitleStyle}" />
                <TextBlock x:Name="AboutText" FontSize="12" Opacity="0.7" Text="KuumoApp" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
