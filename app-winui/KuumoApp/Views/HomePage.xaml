<Page
    x:Class="KuumoApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar
            x:Name="ErrorBar"
            IsOpen="False"
            IsClosable="True"
            Severity="Error"
            Grid.Row="0"
            Margin="24,24,24,0">
            <InfoBar.ActionButton>
                <Button Content="Retry" Click="OnRetryClick" />
            </InfoBar.ActionButton>
        </InfoBar>
        <ScrollViewer Grid.Row="1">
            <StackPanel
                x:Name="Root"
                Padding="24"
                Spacing="16" />
        </ScrollViewer>
        <ProgressRing
            x:Name="LoadingRing"
            IsActive="True"
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>

