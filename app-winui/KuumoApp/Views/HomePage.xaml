<Page
    x:Class="KuumoApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <ScrollViewer>
            <StackPanel
                x:Name="Root"
                Padding="24"
                Spacing="16" />
        </ScrollViewer>
        <ProgressRing
            x:Name="LoadingRing"
            IsActive="True"
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>

