<Page
    x:Class="KuumoApp.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                PlaceholderText="Search tracks, playlists, artists..."
                AutomationProperties.Name="Search query"
                KeyDown="OnSearchKeyDown"
                TextChanged="OnSearchTextChanged" />
            <Button
                Grid.Column="1"
                Content="Search"
                Click="OnSearchClick"
                AutomationProperties.Name="Search" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="12">
            <ListView
                x:Name="SourceTabs"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="OnSourceClick">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding}"
                            FontSize="14"
                            Padding="12,6" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView
                x:Name="TypeTabs"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="OnTypeClick">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding}"
                            FontSize="14"
                            Padding="12,6" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            x:Name="RecentPanel"
            Orientation="Horizontal"
            Spacing="6"
            Visibility="Collapsed" />

        <Grid Grid.Row="3">
            <ListView
                x:Name="ResultList"
                ItemTemplate="{StaticResource TrackRowTemplate}"
                IsItemClickEnabled="True"
                ItemClick="OnResultClick"
                RightTapped="OnResultRightTapped"
                SelectionMode="Single"
                AutomationProperties.Name="Search results" />
            <ProgressRing
                x:Name="SearchingRing"
                IsActive="False"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="NoResultsText"
                Text="No results found"
                Opacity="0.7"
                FontSize="14"
                MaxWidth="360"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
            <StackPanel
                x:Name="ErrorPanel"
                Spacing="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ErrorText"
                    FontSize="14"
                    MaxWidth="420"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
                <Button
                    Content="Retry"
                    HorizontalAlignment="Center"
                    Click="OnRetryClick"
                    AutomationProperties.Name="Retry search" />
            </StackPanel>
        </Grid>

        <Button
            Grid.Row="4"
            x:Name="LoadMoreButton"
            Content="Load more results"
            HorizontalAlignment="Center"
            Visibility="Collapsed"
            Click="OnLoadMoreClick"
            AutomationProperties.Name="Load more search results" />
    </Grid>
</Page>
