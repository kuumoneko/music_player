<Page
    x:Class="KuumoApp.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KuumoApp.Controls"
    Loaded="OnRootLoaded">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Modifiers="Control" Invoked="OnPrevAccelerator" />
        <KeyboardAccelerator Key="Right" Modifiers="Control" Invoked="OnNextAccelerator" />
        <KeyboardAccelerator Key="Up" Modifiers="Control" Invoked="OnVolumeUpAccelerator" />
        <KeyboardAccelerator Key="Down" Modifiers="Control" Invoked="OnVolumeDownAccelerator" />
        <KeyboardAccelerator Key="M" Modifiers="Control" Invoked="OnMuteAccelerator" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnShuffleAccelerator" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRepeatAccelerator" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ambient layer: low-res album art + accent tint + scrim, behind everything. -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="4"
            x:Name="AmbientHost"
            IsHitTestVisible="False"
            Opacity="0">
            <Image
                x:Name="AmbientImage"
                Stretch="UniformToFill"
                Opacity="0.75" />
            <Grid x:Name="AmbientTint" Background="Transparent" />
            <Grid Background="{ThemeResource GlassContentScrimBrush}" />
        </Grid>

        <!-- Custom title bar: nav controls left, drag region center, window controls right. -->
        <Grid Grid.Row="0" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Orientation="Horizontal"
                Spacing="4"
                Margin="4,0,0,0"
                VerticalAlignment="Center">
                <Button x:Name="BackButton" Click="OnBackClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Back (Alt+Left)"
                        AutomationProperties.Name="Back"
                        IsEnabled="False">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button x:Name="ForwardButton" Click="OnForwardClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Forward (Alt+Right)"
                        AutomationProperties.Name="Forward"
                        IsEnabled="False">
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                </Button>
                <Button x:Name="HelpButton" Click="OnHelpClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Keyboard shortcuts"
                        AutomationProperties.Name="Keyboard shortcuts">
                    <FontIcon Glyph="&#xE897;" FontSize="14" />
                </Button>
            </StackPanel>

            <Grid x:Name="TitleBarDragRegion" Grid.Column="1" Background="Transparent" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Margin="0,0,4,0"
                VerticalAlignment="Center">
                <Button x:Name="MinButton" Click="OnMinimizeClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Minimize"
                        AutomationProperties.Name="Minimize">
                    <FontIcon Glyph="&#xE921;" FontSize="14" />
                </Button>
                <Button x:Name="MaxButton" Click="OnMaximizeClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Maximize"
                        AutomationProperties.Name="Maximize">
                    <FontIcon x:Name="MaxGlyph" Glyph="&#xE922;" FontSize="14" />
                </Button>
                <Button x:Name="CloseButton" Click="OnCloseClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Close"
                        AutomationProperties.Name="Close">
                    <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ConnectionBar"
            Grid.Row="1"
            IsOpen="False"
            IsClosable="False"
            Severity="Warning"
            Title="Connection to the music engine lost"
            Message="Reconnecting automatically - playback and downloads are paused until it returns.">
            <InfoBar.ActionButton>
                <Button
                    Content="Retry now"
                    Click="OnConnectionRetryClick"
                    AutomationProperties.Name="Retry connection" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Border
            Grid.Row="2"
            Margin="8,4,8,6"
            CornerRadius="12"
            Background="{ThemeResource GlassPaneBrush}"
            BorderBrush="{ThemeResource GlassStrokeBrush}"
            BorderThickness="1">
            <NavigationView
                x:Name="Nav"
                Background="Transparent"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="True"
                PaneDisplayMode="Left"
                ItemInvoked="OnNavItemInvoked"
                BackRequested="OnNavBackRequested">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Local" Tag="local">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Play queue" Tag="queue">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" CacheSize="8" />
            </NavigationView>
        </Border>

        <Popup x:Name="ToastPopup"
               IsLightDismissEnabled="True"
               ShouldConstrainToRootBounds="True"
               HorizontalOffset="500"
               VerticalOffset="16">
            <Border x:Name="ToastBorder"
                    CornerRadius="8"
                    Padding="16,10"
                    MaxWidth="500"
                    MinWidth="200">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ToastText"
                               TextWrapping="Wrap"
                               Foreground="White"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <Button x:Name="ToastAction"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Toast action"
                            Click="OnToastActionClick" />
                </Grid>
            </Border>
        </Popup>

        <Border
            Grid.Row="3"
            Margin="8,0,8,8"
            CornerRadius="12"
            Background="{ThemeResource GlassElevatedBrush}"
            BorderBrush="{ThemeResource GlassStrokeBrush}"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:PlayerBar x:Name="PlayerBar" />
                <Grid
                    Grid.Row="1"
                    Padding="12,4">
                    <TextBlock
                        x:Name="StatusText"
                        Text="starting..."
                        FontSize="12"
                        Opacity="0.7"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
