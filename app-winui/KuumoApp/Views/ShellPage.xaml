<Page
    x:Class="KuumoApp.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KuumoApp.Controls">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Modifiers="Control" Invoked="OnPrevAccelerator" />
        <KeyboardAccelerator Key="Right" Modifiers="Control" Invoked="OnNextAccelerator" />
        <KeyboardAccelerator Key="Up" Modifiers="Control" Invoked="OnVolumeUpAccelerator" />
        <KeyboardAccelerator Key="Down" Modifiers="Control" Invoked="OnVolumeDownAccelerator" />
        <KeyboardAccelerator Key="M" Modifiers="Control" Invoked="OnMuteAccelerator" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnShuffleAccelerator" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRepeatAccelerator" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            ItemInvoked="OnNavItemInvoked"
            BackRequested="OnNavBackRequested">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="4" Padding="4,4,4,0">
                    <Button x:Name="BackButton" Click="OnBackClick"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Back (Alt+Left)"
                            AutomationProperties.Name="Back"
                            IsEnabled="False">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <Button x:Name="ForwardButton" Click="OnForwardClick"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Forward (Alt+Right)"
                            AutomationProperties.Name="Forward"
                            IsEnabled="False">
                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                    </Button>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Local" Tag="local">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Play queue" Tag="queue">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" CacheSize="0" />
        </NavigationView>

        <Popup x:Name="ToastPopup"
               IsLightDismissEnabled="True"
               ShouldConstrainToRootBounds="True"
               HorizontalOffset="500"
               VerticalOffset="16">
            <Border x:Name="ToastBorder"
                    CornerRadius="8"
                    Padding="16,10"
                    MaxWidth="500"
                    MinWidth="200">
                <TextBlock x:Name="ToastText"
                           TextWrapping="Wrap"
                           Foreground="White"
                           FontSize="13" />
            </Border>
        </Popup>

        <Grid
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:PlayerBar x:Name="PlayerBar" />
                <Grid
                    Grid.Row="1"
                    Padding="12,4">
                    <TextBlock
                        x:Name="StatusText"
                        Text="starting..."
                        FontSize="12"
                        Opacity="0.7"
                        VerticalAlignment="Center" />
                </Grid>
        </Grid>
    </Grid>
</Page>
