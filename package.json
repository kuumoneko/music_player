{
    "name": "kuumoapp",
    "version": "7.3.0",
    "type": "module",
    "description": "KuumoApp music player (WinUI 3 + Bun backend)",
    "scripts": {
        "dev": "bun run --silent ./scripts/dev.ts",
        "build": "bun ./scripts/build.ts",
        "package": "bun run ./scripts/package.ts",
        "release": "bun ./scripts/release.ts",
        "encrypt-credentials": "bun ./scripts/encrypt-credentials.ts",
        "typecheck:bun": "bunx tsc --noEmit",
        "typecheck:dotnet": "dotnet build app-winui/KuumoApp/KuumoApp.csproj -m --no-restore -c Debug /p:GenerateAppxPackageOnBuild=false /p:WindowsAppSDKSelfContained=false -clp:ErrorsOnly -nologo",
        "typecheck": "bun run typecheck:bun && bun run typecheck:dotnet",
        "test": "bun test tests/unit",
        "test:integration": "bun tests/manual/refresh-artist.ts",
        "test:rpc": "bun run scripts/test-rpc.ts"
    },
    "dependencies": {
        "bun": "^1.4.0"
    },
    "devDependencies": {
        "@types/bun": "^1.4.0",
        "dotenv": "^17.4.2",
        "typescript": "^6.0.3"
    }
}
