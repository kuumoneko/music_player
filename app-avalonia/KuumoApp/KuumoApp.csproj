<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>KuumoApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Product>Kuumo Avalonia App</Product>
    <AssemblyTitle>Kuumo Avalonia App</AssemblyTitle>
    <Company>kuumoneko</Company>
    <Description>Kuumo Avalonia App music player</Description>
    <Version>6.0.0</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <RollForward>LatestMinor</RollForward>
  </PropertyGroup>

  <!-- Avalonia packages -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- App icon + sparse package assets -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\AppIcon.ico" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SparsePackage\Assets\*.png" CopyToOutputDirectory="PreserveNewest" Link="Assets\%(Filename)%(Extension)" />
    <Content Include="..\..\build\kuumo-identity.msix" CopyToOutputDirectory="PreserveNewest" Link="kuumo-identity.msix" Condition="Exists('..\..\build\kuumo-identity.msix')" />
  </ItemGroup>
</Project>
