<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KuumoApp.Views.HomePage">
    <Grid>
        <ScrollViewer>
            <StackPanel x:Name="Root" Margin="24" Spacing="16"/>
        </ScrollViewer>
        <ProgressBar x:Name="LoadingRing" IsIndeterminate="True"
                     Width="40" Height="4"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>