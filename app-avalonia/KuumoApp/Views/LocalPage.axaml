<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KuumoApp.Views.LocalPage">
    <Grid Margin="24" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="LocalTitle"
                       Text="Local files"
                       FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppAccentBrush}"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh" Click="OnRefreshClick"/>
                <Button Content="Reload" Click="OnReloadClick"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="TrackPanel" Spacing="2"/>
        </ScrollViewer>
    </Grid>
</UserControl>